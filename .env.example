# Firebaseのプロジェクト設定画面（歯車アイコン → プロジェクトの設定 → マイアプリ）からコピーしてください
# これらの値は公開されても問題ない種類のものです（実際のデータ保護は firestore.rules で行っています）
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# このアプリの利用を許可するGoogleアカウントのメールアドレス（カンマ区切りで複数指定可）
# 例: VITE_ALLOWED_EMAILS=you@gmail.com,family@gmail.com
# 空のままにすると誰でもログインできてしまうので、必ず自分のメールアドレスを入れてください
VITE_ALLOWED_EMAILS=
